# Copy this file to `.env` and fill in your keys.
# Never commit the real `.env` — it is ignored via .gitignore.
# Keys are loaded from the `--env-file` (default `.env`) path.

# OpenAI
OPENAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Together
TOGETHER_API_KEY=

# Groq (optional rate throttling)
GROQ_API_KEY=
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=6000

# Hugging Face (for Inference API usage)
HF_API_TOKEN=
HF_USE_INFERENCE_API=false
HF_DEVICE=cpu

# Local (Ollama / OpenAI-compatible endpoint)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=